# ===== CONFIGURACION OBLIGATORIA (minimo para arrancar) =====

# MongoDB (necesario para guardar datos)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=imperio_shopify

# LLM (motor de IA - necesario para los 10 agentes)
# Obtenlo en: https://emergentagent.com (registro gratuito con creditos)
EMERGENT_LLM_KEY=tu_key_de_emergent

# ===== OPCIONAL: Pon lo que tengas y el sistema lo conecta SOLO =====
# Si dejas vacio los que no tienes, no pasa nada. El sistema funciona igual.
# Cuando metes una key, el sistema la detecta al arrancar y conecta solo.

# Shopify (tu tienda)
SHOPIFY_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxx

# PayPal (saldo + retiros + auto-pay suscripciones)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# Stripe (saldo + retiros a banco)
STRIPE_SECRET_KEY=

# Telegram (bot para recibir alertas e informes)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (webhook para publicar)
DISCORD_WEBHOOK_URL=

# Slack (webhook para alertas e informes)
SLACK_WEBHOOK_URL=

# Mastodon (publicar contenido)
MASTODON_ACCESS_TOKEN=
MASTODON_INSTANCE=

# Reddit (descubrir tendencias)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ImperioAI/1.0

# Resend (enviar emails - 100 gratis/dia)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@imperio.shop

# Wise / TransferWise (wallet multi-moneda)
WISE_API_KEY=
WISE_PROFILE_ID=

# Nordigen Open Banking (banco real BBVA/Santander/CaixaBank - GRATIS)
NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=

# Klaviyo (email marketing)
KLAVIYO_API_KEY=

# Mailchimp (email marketing)
MAILCHIMP_API_KEY=
MAILCHIMP_DC=

# Notion (documentacion)
NOTION_API_KEY=

# Google (Analytics, Search Console, Trends)
GOOGLE_API_KEY=

# OpenAI (alternativa al LLM de Emergent)
OPENAI_API_KEY=

# ===== COMO FUNCIONA =====
# 1. El sistema arranca con `python3 start.py`
# 2. Lee este archivo .env automaticamente
# 3. Detecta cuales keys estan configuradas
# 4. Conecta solo las que encuentre
# 5. Si Shopify esta configurado → activa motor 24/7 solo
# 6. Las que falten las puedes anadir despues desde el dashboard
# 7. No necesitas configurar nada manualmente - todo es automatico
